# =========================================================================
# Saudi Manpower Platform - Environment Variables Template
# Copy this file to `.env.local` and populate it with your real credentials.
# =========================================================================

# 1. Firebase Client SDK Configurations (Used in src/lib/firebase/client.ts)
# Set NEXT_PUBLIC_FIREBASE_API_KEY to "your-api-key" (or leave empty) to enable local Mock Auth.
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="manpower-8565b.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="manpower-8565b"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="manpower-8565b.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:a1b2c3d4e5f6g7h8"

# 2. Firebase Server-Side Admin SDK (Used in src/lib/firebase/admin.ts)
FIREBASE_PROJECT_ID="manpower-8565b"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@manpower-8565b.iam.gserviceaccount.com"
# Note: For private keys, wrap the PEM string containing `\n` characters in quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# 3. AI / Gemini Integration API Key (Used in src/app/api/extract-document/route.ts)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
